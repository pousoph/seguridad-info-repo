<section class="error-pagina">
  <div class="codigo" aria-hidden="true"><%= codigo %></div>
  <h1><%= titulo %></h1>
  <p><%= mensaje %></p>
  <div class="fila">
    <% if (usuario) { %>
    <a class="boton" href="/panel">Ir al inicio</a>
    <% } else { %>
    <a class="boton" href="/">Ir a la portada</a>
    <a class="boton secundario" href="/login">Iniciar sesión</a>
    <% } %>
  </div>
</section>
