<section class="portada">
  <h1>Hola, <%= usuario.username %></h1>
  <p class="entrada-texto">
    Tu cuenta tiene el rol <strong><%= usuario.rol %></strong>.
    <% if (esAdministrador) { %>
    Puedes usar las dos herramientas del taller y dar de alta usuarios nuevos.
    <% } else { %>
    Puedes usar las dos herramientas del taller.
    <% } %>
  </p>
</section>

<section class="bloque">
  <h2>Herramientas</h2>
  <p class="guia">
    Cada página comprueba tu sesión y tu rol en el servidor antes de entregar
    su contenido y sus scripts.
  </p>
  <div class="accesos">
    <a class="acceso-herramienta" href="/herramientas/cifrar">
      <h3>Cifrar</h3>
      <p>César, Afín y Vigenère sobre el alfabeto español de 27 letras.</p>
      <span class="ir">Abrir la herramienta</span>
    </a>
    <a class="acceso-herramienta" href="/herramientas/analizar">
      <h3>Analizar</h3>
      <p>Índice de coincidencia, frecuencias y ataque automático a un criptograma.</p>
      <span class="ir">Abrir la herramienta</span>
    </a>
    <% if (esAdministrador) { %>
    <a class="acceso-herramienta" href="/usuarios/nuevo">
      <h3>Nuevo usuario</h3>
      <p>Crea una cuenta con su rol. La contraseña se guarda como hash BCrypt.</p>
      <span class="ir">Crear una cuenta</span>
    </a>
    <% } %>
  </div>
</section>

<section class="bloque">
  <h2>Sesión</h2>
  <p class="guia">
    Caduca tras 30 minutos sin actividad. Al cerrarla se destruye en el
    servidor y se borra la cookie del navegador.
  </p>
  <form method="post" action="/logout" class="fila">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="secundario">Cerrar sesión</button>
  </form>
</section>
