<div class="acceso">
  <section class="acceso-formulario">
    <a class="marca" href="/">
      <span class="logo"><%- include('partials/icono', { nombre: 'candado' }) %></span>
      Seguridad de la Información
    </a>

    <div class="acceso-cuerpo">
      <h1>Iniciar sesión</h1>
      <p class="subtitulo">Entra con tu cuenta del taller para usar las herramientas.</p>

      <form class="formulario" method="post" action="/api/login">
        <%# Token CSRF: generado en el servidor y guardado en la sesión. %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <% if (error) { %>
        <p class="aviso" role="alert"><%- include('partials/icono', { nombre: 'alerta' }) %><span><%= error %></span></p>
        <% } %>

        <div class="campo">
          <label for="username">Usuario</label>
          <input type="text" id="username" name="username"
                 autocomplete="username" autocapitalize="none" spellcheck="false"
                 maxlength="50" required value="<%= username %>">
        </div>

        <div class="campo">
          <label for="password">Contraseña</label>
          <div class="campo-clave">
            <input type="password" id="password" name="password"
                   autocomplete="current-password" required>
            <button type="button" class="ver-clave" data-ver-clave="password"
                    aria-label="Mostrar contraseña" aria-pressed="false">
              <span data-icono="mostrar"><%- include('partials/icono', { nombre: 'ojo' }) %></span>
              <span data-icono="ocultar" hidden><%- include('partials/icono', { nombre: 'ojoTachado' }) %></span>
            </button>
          </div>
        </div>

        <button type="submit" class="ancho">Entrar</button>
      </form>
    </div>

    <footer class="pie">
      <span>Universidad El Bosque · 2026-II</span>
      <a class="enlace-suave" href="/">Volver al inicio</a>
    </footer>
  </section>

  <aside class="acceso-ilustracion" aria-hidden="true">
    <%- include('partials/ilustracion') %>
    <p class="lema">Tu contraseña nunca viaja en claro a la base.<span>Se compara en el servidor contra su hash BCrypt.</span></p>
  </aside>
</div>
