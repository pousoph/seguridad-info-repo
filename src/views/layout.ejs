<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= titulo %> · Seguridad de la Información</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles/style.css">
</head>
<body>
<div class="marco">

  <header class="encabezado">
    <a class="sello" href="/">
      <span class="punto"></span>
      Seguridad de la Información <span class="curso">2026-II</span>
    </a>
    <nav class="navegacion" aria-label="Principal">
      <% for (const enlace of enlaces) { %>
      <a href="<%= enlace.href %>"<% if (enlace.href === activa) { %> aria-current="page"<% } %>><%= enlace.texto %></a>
      <% } %>
      <% if (usuario) { %>
      <span class="separador" aria-hidden="true"></span>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="enlace-nav">Cerrar sesión</button>
      </form>
      <% } %>
    </nav>
  </header>

  <%- cuerpo %>

  <footer class="pie">
    <span>Elaborado por Sophy Valentina Guiza Valencia</span>
    <span>Universidad El Bosque · Seguridad de la Información 2026-II</span>
  </footer>

</div>

<%# Scripts de la vista. Los de las herramientas se sirven por rutas
    protegidas con el mismo guardián que la página. %>
<% for (const src of scripts) { %>
<script src="<%= src %>"></script>
<% } %>
</body>
</html>
